# ============================================================
# VibeFast — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Encuentra estas keys en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# Proveedor de IA (openai | openrouter | gemini | ollama). Por defecto openai.
# Modelo opcional: AI_MODEL=llama-3.1-8b-instruct:free
AI_PROVIDER=openai
AI_MODEL=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- OpenRouter (alternativa gratuita) ---
# Key gratis en https://openrouter.ai/keys — usa modelos con sufijo ":free"
OPENROUTER_API_KEY=

# --- Gemini (alternativa gratuita) ---
# Key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ollama (local, sin key) ---
# Instala Ollama: https://ollama.com — luego: ollama pull llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=

# --- PostHog (opcional, analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- OAuth providers (Gmail receta, opcional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
